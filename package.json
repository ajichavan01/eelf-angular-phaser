{
  "name": "eelf-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:angular": "npm run dev --workspace @eelf/angular",
    "dev:phaser": "npm run dev --workspace @eelf/phaser",
    "dev": "npm run dev --workspaces --if-present --parallel",
    "build": "npm run build --workspace @eelf/angular && npm run build --workspace @eelf/phaser",
    "test": "node --experimental-strip-types --test packages/simulation/test/*.test.ts",
    "benchmark": "node --experimental-strip-types packages/simulation/benchmark.ts",
    "test:ui": "playwright test",
    "typecheck": "tsc --project packages/simulation/tsconfig.json --noEmit && tsc --project packages/browser/tsconfig.json --noEmit",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3"
  }
}
